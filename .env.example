# SimpleFIN Bridge credentials
# Get these by claiming a Setup Token at https://bridge.simplefin.org
# See README.md for setup instructions
SIMPLEFIN_USERNAME=your_simplefin_username_hex
SIMPLEFIN_PASSWORD=your_simplefin_password_hex
SIMPLEFIN_BASE_URL=https://beta-bridge.simplefin.org/simplefin

# Gmail credentials for weekly digest emails
# Create an App Password at https://myaccount.google.com/apppasswords
GMAIL_SENDER=you@gmail.com
GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx

# Digest recipients
EMAIL_PRIMARY=you@gmail.com
EMAIL_SECONDARY=partner@gmail.com
